local settings = {
    autoThrow    = false,
    autoCollect  = false,
    autoRebirth  = false,
    farmDelay    = 0.25,
    rebirthAt    = 1000,
    moveSpeed    = 40,
    walkRadius   = 60,
}

local function bindCharacter(c)
    hrp = c:WaitForChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = settings.moveSpeed end
end
player.CharacterAdded:Connect(bindCharacter)

local remoteCache = { throwFood = nil, rebirth = nil, collect = nil }
local function scoreRemoteName(name)
    name = name:lower()
    if name:find("throwfood") or (name:find("throw") and name:find("food")) then return "throwFood", 100 end
    if name:find("feed") or name:find("throwitem") then return "throwFood", 80 end
    if name:find("rebirth") then return "rebirth", 100 end
    if name:find("collect") or name:find("pickup") then return "collect", 80 end
    return nil, 0
end
local function rebuildRemoteCache()
    local best = { throwFood = 0, rebirth = 0, collect = 0 }
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local slot, weight = scoreRemoteName(obj.Name)
            if slot and weight > best[slot] then best[slot] = weight; remoteCache[slot] = obj end
        end
    end
end
rebuildRemoteCache()
task.delay(3, rebuildRemoteCache)
task.delay(8, rebuildRemoteCache)

local ANIMAL_KEYWORDS = {"animal","chicken","cat","dog","cow","sheep","rabbit","pig","duck","horse","goat","bird","pet","monster","mob"}
local animalCache, lastAnimalScan = {}, 0
local function looksLikeAnimal(m)
    local n = m.Name:lower()
    for _, kw in ipairs(ANIMAL_KEYWORDS) do if n:find(kw, 1, true) then return true end end
    return false
end
local function refreshAnimals()
    if tick() - lastAnimalScan < 1.5 then return animalCache end
    lastAnimalScan = tick()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and looksLikeAnimal(obj) then
            local h = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart")
            if h and (h.Position - hrp.Position).Magnitude < 500 then table.insert(list, h) end
        end
    end
    animalCache = list
    return list
end

local function detectAntiCheat()
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("LocalScript") or obj:IsA("Script") then
            local n = obj.Name:lower()
            if n:find("anticheat") or n:find("acclient") then return true end
        end
    end
    return false
end
local HAS_AC = detectAntiCheat()
local function moveTo(pos)
    if not hrp or not hrp.Parent then return end
    if HAS_AC then
        local d = pos - hrp.Position
        if d.Magnitude > 1 then hrp.AssemblyLinearVelocity = d.Unit * math.min(d.Magnitude * 4, 200) end
    else
        hrp.CFrame = CFrame.new(pos)
    end
end

local function throwFoodAt(pos)
    local re = remoteCache.throwFood
    if not re then return end
    if re:IsA("RemoteEvent") then re:FireServer(pos) else pcall(function() re:InvokeServer(pos) end) end
end

local COLLECT_KEYWORDS = {"reward","coin","point","collect","drop","gem","cash","money","food","apple","carrot"}
local function isCollectible(p)
    local n = p.Name:lower()
    for _, kw in ipairs(COLLECT_KEYWORDS) do if n:find(kw, 1, true) then return true end end
    return false
end
local function collectNearby()
    if not hrp or not hrp.Parent then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and isCollectible(obj) then
            if (hrp.Position - obj.Position).Magnitude < 80 then
                moveTo(obj.Position + Vector3.new(0, 3, 0))
                task.wait(0.05)
            end
        end
    end
    if remoteCache.collect then pcall(function() remoteCache.collect:FireServer() end) end
end

local function tryRebirth()
    if remoteCache.rebirth then
        pcall(function() remoteCache.rebirth:FireServer() end)
        return true
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local n = (obj.Parent.Name .. " " .. (obj.ActionText or "")):lower()
            if n:find("rebirth") or n:find("prestige") then
                if fireproximityprompt then pcall(fireproximityprompt, obj) end
                return true
            end
        end
    end
    return false
end

local function getScore()
    local ls = player:FindFirstChild("leaderstats")
    if not ls then return 0 end
    for _, v in ipairs(ls:GetChildren()) do
        if v:IsA("IntValue") or v:IsA("NumberValue") then
            local n = v.Name:lower()
            if n:find("point") or n:find("score") or n:find("cash") or n:find("coin") then return v.Value end
        end
    end
    return 0
end

