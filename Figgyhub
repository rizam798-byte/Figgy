task.spawn(function()
    while true do
        task.wait(settings.farmDelay)
        if hrp and hrp.Parent then
            if settings.autoThrow then
                local animals = refreshAnimals()
                if #animals == 0 then
                    local o = Vector3.new(math.random(-settings.walkRadius, settings.walkRadius), 0,
                                          math.random(-settings.walkRadius, settings.walkRadius))
                    moveTo(hrp.Position + o)
                else
                    for _, a in ipairs(animals) do
                        if not hrp.Parent then break end
                        moveTo(a.Position + Vector3.new(0, 3, 0))
                        throwFoodAt(a.Position)
                        task.wait(0.05)
                    end
                end
            end
            if settings.autoCollect then collectNearby() end
        end
    end
end)

task.spawn(function()
