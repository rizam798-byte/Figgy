local btnY = 85
local function makeToggle(label, key)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 38)
    btn.Position = UDim2.new(0, 10, 0, btnY)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    btn.Text = "❌ " .. label .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(220, 220, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Parent = main
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btnY = btnY + 44
    btn.MouseButton1Click:Connect(function()
        settings[key] = not settings[key]
        btn.BackgroundColor3 = settings[key] and Color3.fromRGB(0, 180, 90) or Color3.fromRGB(50, 50, 70)
        btn.Text = (settings[key] and "✅ " or "❌ ") .. label .. (settings[key] and ": ON" or ": OFF")
    end)
end
